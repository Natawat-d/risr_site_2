/// Accreditations and memberships, as a page of their own.
///
/// Singleton with numbered slots, the same shape as every other content table
/// here (`home_logo1..7`, `home_pic1..9`): it keeps the schema-driven admin
/// editor working with no bespoke page, which is the whole reason that pattern
/// is used. Empty slots are skipped when the page renders.
model Accreditation {
  id      Int     @id @default(autoincrement())
  heading String? @db.Text
  intro   String? @db.Text

  banner_image String? @db.Text

  logo1   String? @db.Text
  name1   String? @db.Text
  detail1 String? @db.Text
  link1   String? @db.Text

  logo2   String? @db.Text
  name2   String? @db.Text
  detail2 String? @db.Text
  link2   String? @db.Text

  logo3   String? @db.Text
  name3   String? @db.Text
  detail3 String? @db.Text
  link3   String? @db.Text

  logo4   String? @db.Text
  name4   String? @db.Text
  detail4 String? @db.Text
  link4   String? @db.Text

  logo5   String? @db.Text
  name5   String? @db.Text
  detail5 String? @db.Text
  link5   String? @db.Text

  logo6   String? @db.Text
  name6   String? @db.Text
  detail6 String? @db.Text
  link6   String? @db.Text

  logo7   String? @db.Text
  name7   String? @db.Text
  detail7 String? @db.Text
  link7   String? @db.Text

  logo8   String? @db.Text
  name8   String? @db.Text
  detail8 String? @db.Text
  link8   String? @db.Text

  @@map("accreditations")
}

/// Open House / Open Day page content, and whether registration is taking place.
model OpenHouse {
  id           Int     @id @default(autoincrement())
  heading      String? @db.Text
  intro        String? @db.Text
  /// Free text — "Saturday 14 September, 9:00–12:00". Kept as text rather than
  /// a date because the school writes these as a phrase, sometimes for several
  /// sessions at once.
  when_text    String? @db.Text
  where_text   String? @db.Text
  details      String? @db.Text
  banner_image String? @db.Text
  photo1       String? @db.Text

  /// Off hides the form and shows the closed message instead. Marketing turns
  /// this on for the weeks an Open House is actually being run.
  registration_open Boolean @default(true)
  closed_message    String? @db.Text
  /// Optional: hand registration to an external system instead of our form.
  external_link     String? @db.Text

  @@map("open_house")
}

/// One Open House registration, from the public form.
model OpenHouseRegistration {
  id         Int      @id @default(autoincrement())
  name       String   @db.Text
  email      String   @db.Text
  telephone  String?  @db.Text
  /// Which year group the child would enter — the question admissions asks first.
  grade      String?  @db.Text
  attendees  Int      @default(1)
  message    String?  @db.Text
  /// 0 = new, 1 = contacted. Mirrors contact_form's read/unread flag.
  status     Int      @default(0)
  created_at DateTime @default(now())

  @@map("open_house_registration")
}

/// The homepage pop-up: one to three slides that rotate on their own.
///
/// Admin-managed, because Marketing asked to add and remove these themselves
/// rather than send us a request each time. A slide with no image is skipped,
/// so "how many pop-ups are there" is answered by filling in one, two or three
/// slots — there is no count to keep in step.
///
/// `enabled` off hides it entirely without clearing the slides, which is what
/// you want between campaigns.
model Popup {
  id      Int     @id @default(autoincrement())
  enabled Boolean @default(false)

  /// Seconds each slide is shown before the next. Ignored with one slide.
  interval_seconds Int @default(5)

  image1 String? @db.Text
  link1  String? @db.Text
  alt1   String? @db.Text

  image2 String? @db.Text
  link2  String? @db.Text
  alt2   String? @db.Text

  image3 String? @db.Text
  link3  String? @db.Text
  alt3   String? @db.Text

  @@map("popup")
}

/// Site-wide branding. Separate from `home` because the logo is on every page,
/// not just the homepage — and because a school changing its crest should not
/// have to open a thirty-field homepage editor to do it.
model Branding {
  id      Int     @id @default(autoincrement())
  /// The mark in the top navigation bar. Empty falls back to the ported
  /// /img/nav_top.png, so clearing it restores the original rather than
  /// leaving a gap.
  logo    String?
  /// The small icon browsers show on the tab. Empty falls back to /logo.png.
  favicon String?

  @@map("branding")
}
