# risr_site2 reads the ORIGINAL site's database, read-only. Content is edited
# in the existing admin at /risr/admin; this app only presents it.
DATABASE_URL="postgresql://risr:CHANGEME@localhost:5432/risr_site?schema=public"

# Where the shared uploads volume is mounted.
UPLOAD_DIR=./uploads

# Served beside the original site while both run in parallel.
NEXT_PUBLIC_BASE_PATH=/risr2
